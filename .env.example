# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor. Usada por las Server Actions para escribir postulaciones,
# participaciones, mensajes y pedidos. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
# Sólo servidor: el Checkout es alojado, no hace falta clave publicable.
STRIPE_SECRET_KEY=

# Distinto en local (lo imprime `stripe listen`) y en producción
# (Developers → Webhooks → endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=

# Base para success_url y cancel_url. Sin NEXT_PUBLIC_: sólo la usa el servidor.
SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
# Correo transaccional que mandamos nosotros: verificación del tutor,
# invitación al expediente y acuse de las solicitudes ARCO. Sin esto el
# sitio funciona igual, pero esos avisos no salen.
#
# Los correos de Supabase Auth (confirmación de cuenta, recuperación de
# contraseña) NO pasan por aquí: se configuran aparte, en el SMTP del
# dashboard de Supabase.
RESEND_API_KEY=

# Remitente verificado en Resend. Formato: Nombre <correo@dominio.com>
EMAIL_FROM=

# Opcional: copia interna de lo que entra por los formularios.
EMAIL_INTERNO=

# Ponlo a 1 sólo cuando el sitio deba salir en buscadores. Sin esto el
# robots.txt bloquea todo: mientras sea una demo con contenido de relleno,
# no queremos que se indexe. No se deduce de NODE_ENV porque la demo también
# se construye en modo producción.
SITIO_INDEXABLE=
