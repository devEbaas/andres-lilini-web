# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor. Usada por las Server Actions para escribir postulaciones,
# participaciones, mensajes y pedidos. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
# Sólo servidor: el Checkout es alojado, no hace falta clave publicable.
STRIPE_SECRET_KEY=

# Distinto en local (lo imprime `stripe listen`) y en producción
# (Developers → Webhooks → endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=

# Base para success_url y cancel_url. Sin NEXT_PUBLIC_: sólo la usa el servidor.
SITE_URL=http://localhost:3000
